<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ArrTags</RootNamespace>
    <AssemblyName>ArrTags</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <!-- ADR-010: pin the renderer stack to the exact SkiaSharp managed and Linux
       native asset versions used by the Jellyfin 12.0.0 host. HarfBuzzSharp is
       deliberately not referenced until task 4.8 decides whether it is needed. -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>

  <!-- ADR-010: the bundled DejaVu Sans Bold 2.37 font is loaded from this
       plugin-owned embedded resource by bytes, never from a host font path. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/DejaVuSans-Bold.ttf">
      <LogicalName>ArrTags.Resources.DejaVuSans-Bold.ttf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- ADR-010 / task 5.4: V1 claims only linux-x64. The pinned host and the
       measured plugin load-context behavior (docs/research/skia-host-compatibility.md
       section 3) validate this single RID; other Linux RIDs are not claimed and
       no arbitrary system Skia library is loaded. -->
  <PropertyGroup>
    <PluginRuntimeIdentifier Condition="'$(PluginRuntimeIdentifier)' == ''">linux-x64</PluginRuntimeIdentifier>
  </PropertyGroup>

  <Target Name="PackagePlugin" AfterTargets="Build" Condition="'$(PackagePlugin)' == 'true'">
    <PropertyGroup>
      <PluginStagingDirectory>$(MSBuildThisFileDirectory)../../artifacts/staging</PluginStagingDirectory>
      <PluginPackageFile>$(MSBuildThisFileDirectory)../../artifacts/ArrTags_$(Version).zip</PluginPackageFile>
    </PropertyGroup>

    <!-- ADR-010 / task 5.4: the renderer's managed binding and the matching
         Linux native asset are taken from the project's resolved runtime assets,
         not from a hard-coded cache path. The measured host plugin load context
         probes only the plugin folder root (not x64/ or runtimes/<rid>/native/),
         so both files are staged next to ArrTags.dll. -->
    <ItemGroup>
      <_ArrTagsManagedRendererAsset Include="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.Filename)%(RuntimeCopyLocalItems.Extension)' == 'SkiaSharp.dll'" />
      <_ArrTagsNativeRendererAsset Include="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == '$(PluginRuntimeIdentifier)' and '%(RuntimeTargetsCopyLocalItems.AssetType)' == 'native' and '%(RuntimeTargetsCopyLocalItems.Filename)%(RuntimeTargetsCopyLocalItems.Extension)' == 'libSkiaSharp.so'" />
      <_ArrTagsLicenseFile Include="$(MSBuildThisFileDirectory)../../licenses/*" />
    </ItemGroup>

    <Error Condition="'@(_ArrTagsManagedRendererAsset)' == ''" Text="PackagePlugin: the managed renderer asset SkiaSharp.dll was not resolved from the project's pinned references." />
    <Error Condition="'@(_ArrTagsNativeRendererAsset)' == ''" Text="PackagePlugin: the Linux native renderer asset libSkiaSharp.so was not resolved for RID '$(PluginRuntimeIdentifier)'." />

    <RemoveDir Directories="$(PluginStagingDirectory)" />
    <MakeDir Directories="$(PluginStagingDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginStagingDirectory)" />
    <Copy SourceFiles="@(_ArrTagsManagedRendererAsset)" DestinationFolder="$(PluginStagingDirectory)" />
    <Copy SourceFiles="@(_ArrTagsNativeRendererAsset)" DestinationFolder="$(PluginStagingDirectory)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).deps.json" DestinationFolder="$(PluginStagingDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../build.yaml" DestinationFolder="$(PluginStagingDirectory)" />

    <!-- ADR-010: the font and Skia license notices ship with the plugin package. -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../THIRD-PARTY-NOTICES.md" DestinationFolder="$(PluginStagingDirectory)" />
    <Copy SourceFiles="@(_ArrTagsLicenseFile)" DestinationFolder="$(PluginStagingDirectory)/licenses" />

    <Delete Files="$(PluginPackageFile)" />
    <ZipDirectory SourceDirectory="$(PluginStagingDirectory)" DestinationFile="$(PluginPackageFile)" />
    <RemoveDir Directories="$(PluginStagingDirectory)" />

    <Message Importance="high" Text="Created plugin package: $(PluginPackageFile)" />
  </Target>

</Project>
