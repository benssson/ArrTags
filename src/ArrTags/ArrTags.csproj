<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ArrTags</RootNamespace>
    <AssemblyName>ArrTags</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>

    <!-- Phase 7 task 7.5: normalize the compiler's source and PDB paths to a
         fixed root so the deterministic plugin assembly (and therefore the
         release package) is byte-identical regardless of where the source tree
         is checked out. Without this the absolute PDB path is embedded in the
         debug directory and changes the release artifact's SHA-256. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/ArrTags</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <!-- ADR-015 supersedes the bundling parts of ADR-010: pin the renderer stack
       to the exact SkiaSharp managed and native versions the Jellyfin 12.0.0
       host uses, but compile against them only and never ship or copy them. The
       plugin resolves the host's SkiaSharp managed assembly and native library
       through the default load context; shipping a second copy causes a fatal
       type-identity conflict (task 7.3 finding 7.3-F1). SkiaSharp.NativeAssets.Linux
       stays compile-time-only so the expected native ABI remains pinned without
       shipping a native library. HarfBuzzSharp is deliberately not referenced. -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ADR-010: the bundled DejaVu Sans Bold 2.37 font is loaded from this
       plugin-owned embedded resource by bytes, never from a host font path. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/DejaVuSans-Bold.ttf">
      <LogicalName>ArrTags.Resources.DejaVuSans-Bold.ttf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Phase 7 task 7.5: this target stages the exact release files; the
       deterministic archive is then produced by `scripts/pack-release.cs`
       (invoked from `build.sh package`). The previous `ZipDirectory` task
       enumerated the staging directory in filesystem order and stamped entries
       with source modification times, so repeated clean package runs produced
       the same contents with different bytes and SHA-256. Staging stays in
       MSBuild because it owns the resolved output paths. -->
  <Target Name="PackagePlugin" AfterTargets="Build" Condition="'$(PackagePlugin)' == 'true'">
    <PropertyGroup>
      <PluginStagingDirectory>$(MSBuildThisFileDirectory)../../artifacts/staging</PluginStagingDirectory>
    </PropertyGroup>

    <!-- ADR-015 (supersedes the bundling parts of ADR-010): the package carries
         only the plugin assembly, its dependency manifest, the plugin manifest,
         and the font/Skia notices. The renderer's managed and native SkiaSharp
         assets are deliberately not staged; the plugin shares the host's
         SkiaSharp through the default load context. V1 is validated on the
         linux-x64 pinned host, whose own native libSkiaSharp.so is used. -->
    <ItemGroup>
      <_ArrTagsLicenseFile Include="$(MSBuildThisFileDirectory)../../licenses/*" />
    </ItemGroup>

    <RemoveDir Directories="$(PluginStagingDirectory)" />
    <MakeDir Directories="$(PluginStagingDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginStagingDirectory)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).deps.json" DestinationFolder="$(PluginStagingDirectory)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../build.yaml" DestinationFolder="$(PluginStagingDirectory)" />

    <!-- The bundled font's license notice and the compile-time Skia notices ship
         with the plugin package. -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../THIRD-PARTY-NOTICES.md" DestinationFolder="$(PluginStagingDirectory)" />
    <Copy SourceFiles="@(_ArrTagsLicenseFile)" DestinationFolder="$(PluginStagingDirectory)/licenses" />

    <Message Importance="high" Text="Staged plugin package files: $(PluginStagingDirectory)" />
  </Target>

</Project>
